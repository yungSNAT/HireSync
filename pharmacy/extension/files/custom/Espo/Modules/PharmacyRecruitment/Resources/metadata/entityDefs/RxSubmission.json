{
    "fields": {
        "name": {
            "type": "varchar",
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "candidate": {
            "type": "link",
            "required": true
        },
        "jobOrder": {
            "type": "link",
            "required": true
        },
        "stage": {
            "type": "enum",
            "options": [
                "Shortlisted",
                "Submitted",
                "Client interview",
                "Reference check",
                "Offer",
                "Placed",
                "Rejected",
                "Withdrawn"
            ],
            "default": "Shortlisted",
            "audited": true,
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Placed": "success",
                "Rejected": "danger",
                "Withdrawn": "info"
            }
        },
        "consentDate": {
            "type": "date",
            "tooltip": true,
            "audited": true
        },
        "submittedAt": {
            "type": "date"
        },
        "interviewAt": {
            "type": "datetime"
        },
        "rejectionReason": {
            "type": "varchar",
            "maxLength": 150
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "candidate": {
            "type": "belongsTo",
            "entity": "RxCandidate",
            "foreign": "submissions"
        },
        "jobOrder": {
            "type": "belongsTo",
            "entity": "RxJobOrder",
            "foreign": "submissions"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
