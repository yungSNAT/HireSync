{
    "fields": {
        "name": {
            "type": "varchar",
            "readOnly": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Open",
                "Offered",
                "Confirmed",
                "Completed",
                "Cancelled"
            ],
            "default": "Open",
            "audited": true,
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Offered": "warning",
                "Confirmed": "primary",
                "Completed": "success",
                "Cancelled": "info"
            }
        },
        "dateStart": {
            "type": "datetime",
            "required": true,
            "audited": true
        },
        "dateEnd": {
            "type": "datetime",
            "required": true,
            "after": "dateStart",
            "audited": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "account": {
            "type": "link",
            "required": true,
            "audited": true
        },
        "candidate": {
            "type": "link",
            "audited": true
        },
        "jobOrder": {
            "type": "link",
            "audited": true
        },
        "profession": {
            "type": "enum",
            "optionsReference": "RxCandidate.profession",
            "required": true,
            "default": "Pharmacist",
            "audited": true
        },
        "engagementModel": {
            "type": "enum",
            "options": [
                "",
                "Introduction only",
                "Agency pays contractor",
                "Agency employs"
            ],
            "tooltip": true
        },
        "breakMinutes": {
            "type": "int",
            "min": 0,
            "default": 0
        },
        "payRate": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true,
            "tooltip": true
        },
        "chargeRate": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true,
            "tooltip": true
        },
        "paidHours": {
            "type": "float",
            "readOnly": true
        },
        "payTotal": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true,
            "readOnly": true
        },
        "chargeTotal": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true,
            "readOnly": true
        },
        "margin": {
            "type": "currency",
            "onlyDefaultCurrency": true,
            "readOnly": true,
            "tooltip": true
        },
        "travelAllowance": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true
        },
        "accommodation": {
            "type": "varchar",
            "maxLength": 150
        },
        "timesheetReceived": {
            "type": "bool"
        },
        "invoiced": {
            "type": "bool"
        },
        "atRisk": {
            "type": "bool",
            "readOnly": true,
            "tooltip": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "rxShifts"
        },
        "candidate": {
            "type": "belongsTo",
            "entity": "RxCandidate",
            "foreign": "shifts"
        },
        "jobOrder": {
            "type": "belongsTo",
            "entity": "RxJobOrder",
            "foreign": "shifts"
        }
    },
    "collection": {
        "orderBy": "dateStart",
        "order": "desc"
    },
    "indexes": {
        "dateStartStatus": {
            "columns": [
                "dateStart",
                "status"
            ]
        },
        "dateStart": {
            "columns": [
                "dateStart",
                "deleted"
            ]
        },
        "status": {
            "columns": [
                "status",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "assignedUserStatus": {
            "columns": [
                "assignedUserId",
                "status"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
