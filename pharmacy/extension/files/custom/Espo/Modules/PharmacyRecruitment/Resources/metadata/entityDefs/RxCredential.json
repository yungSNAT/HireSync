{
    "fields": {
        "name": {
            "type": "varchar",
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "candidate": {
            "type": "link",
            "required": true
        },
        "type": {
            "type": "enum",
            "options": [
                "Ahpra general registration",
                "Ahpra provisional registration",
                "Ahpra limited registration",
                "Right to work",
                "Professional indemnity insurance",
                "Identity check",
                "National police check",
                "Working with Children Check",
                "NDIS Worker Screening Clearance",
                "Aged care statutory declaration",
                "NSW Health vaccination evidence",
                "Immuniser certificate",
                "Immuniser annual review",
                "CPR certificate",
                "Paediatric CPR certificate",
                "MMR Credential",
                "ACOP Credential",
                "OTP Standards attestation",
                "UTI treatment training",
                "Hormonal contraception training",
                "Medicine injection training",
                "Minor skin conditions training"
            ],
            "required": true,
            "audited": true
        },
        "identifier": {
            "type": "varchar",
            "maxLength": 50,
            "isPersonalData": true,
            "audited": true,
            "tooltip": true
        },
        "issueDate": {
            "type": "date"
        },
        "expiryDate": {
            "type": "date",
            "audited": true,
            "tooltip": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Pending",
                "Verified",
                "Rejected"
            ],
            "default": "Pending",
            "audited": true,
            "tooltip": true,
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Verified": "success",
                "Rejected": "danger"
            }
        },
        "verifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "verifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "verificationMethod": {
            "type": "enum",
            "options": [
                "",
                "Ahpra public register",
                "Ahpra PIE",
                "OCG online verification",
                "VEVO",
                "Passport or citizenship evidence",
                "Insurer document",
                "Employer or third party letter",
                "Original sighted",
                "Certified copy"
            ],
            "audited": true
        },
        "evidence": {
            "type": "file",
            "isPersonalData": true,
            "accept": [
                ".pdf",
                ".png",
                ".jpg",
                ".jpeg"
            ]
        },
        "verifyingEntity": {
            "type": "varchar",
            "maxLength": 100,
            "tooltip": true,
            "audited": true
        },
        "workRightsBasis": {
            "type": "enum",
            "options": [
                "",
                "Australian citizen",
                "Permanent or indefinite visa",
                "Time-limited visa"
            ],
            "audited": true,
            "tooltip": true
        },
        "registerStatus": {
            "type": "enum",
            "options": [
                "",
                "Cleared",
                "Application in progress",
                "Barred",
                "Interim barred",
                "Not found",
                "Expired",
                "Closed"
            ],
            "audited": true,
            "tooltip": true
        },
        "checkType": {
            "type": "enum",
            "options": [
                "",
                "Paid",
                "Volunteer"
            ],
            "audited": true
        },
        "dateOfBirth": {
            "type": "date",
            "isPersonalData": true,
            "audited": true
        },
        "coverAmount": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true,
            "audited": true,
            "tooltip": true
        },
        "insuranceArrangement": {
            "type": "enum",
            "options": [
                "",
                "Individual",
                "Employer",
                "Other third party"
            ],
            "audited": true
        },
        "conditions": {
            "type": "text",
            "tooltip": true,
            "audited": true
        },
        "reminderLevel": {
            "type": "int",
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "candidate": {
            "type": "belongsTo",
            "entity": "RxCandidate",
            "foreign": "credentials"
        },
        "verifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "expiryDate",
        "order": "asc",
        "textFilterFields": [
            "name",
            "identifier"
        ]
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        },
        "expiry": {
            "columns": [
                "status",
                "expiryDate",
                "deleted"
            ]
        }
    }
}
