{
    "fields": {
        "name": {
            "type": "varchar",
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "candidate": {
            "type": "link",
            "required": true,
            "audited": true
        },
        "jobOrder": {
            "type": "link",
            "required": true,
            "audited": true
        },
        "account": {
            "type": "link",
            "required": true,
            "audited": true
        },
        "type": {
            "type": "enum",
            "options": [
                "Permanent",
                "Fixed term",
                "Locum"
            ],
            "required": true,
            "default": "Permanent"
        },
        "startDate": {
            "type": "date",
            "required": true,
            "audited": true
        },
        "endDate": {
            "type": "date",
            "after": "startDate"
        },
        "status": {
            "type": "enum",
            "options": [
                "Pending start",
                "Active",
                "Completed",
                "Fallen through"
            ],
            "default": "Pending start",
            "audited": true,
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Active": "primary",
                "Completed": "success",
                "Fallen through": "danger"
            }
        },
        "salary": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true
        },
        "feeAmount": {
            "type": "currency",
            "min": 0,
            "onlyDefaultCurrency": true,
            "tooltip": true
        },
        "invoiceNumber": {
            "type": "varchar",
            "maxLength": 50
        },
        "invoiceDate": {
            "type": "date"
        },
        "guaranteeEndDate": {
            "type": "date"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "candidate": {
            "type": "belongsTo",
            "entity": "RxCandidate",
            "foreign": "placements"
        },
        "jobOrder": {
            "type": "belongsTo",
            "entity": "RxJobOrder",
            "foreign": "placements"
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "rxPlacements"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
